      <!-- ===================== TAB 3: Sprite Collections ===================== -->
      <widget class="QWidget" name="tabSpriteCollections">
       <attribute name="title">
        <string>Sprite Collections</string>
       </attribute>
       <layout class="QVBoxLayout" name="spriteColLayout">
