      <!-- ===================== TAB 4: Sprite Editor ===================== -->
      <widget class="QWidget" name="tabSpriteEditor">
       <attribute name="title">
        <string>Sprite Editor</string>
       </attribute>
       <layout class="QVBoxLayout" name="spriteEditorLayout">
        <!-- Info label -->
        <item>
         <widget class="QLabel" name="theEditorInfoLabel">
          <property name="text">
           <string>No sprite selected — click a sprite in the Collections tab</string>
          </property>
