          <property name="text">
           <string>No sprite selected — click a sprite in the Collections tab</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <!-- Main area: canvas on left, tool panel on right -->
        <item>
         <layout class="QHBoxLayout" name="editorMainLayout">
          <!-- Left: canvas -->
          <item>
           <widget class="QScrollArea" name="theEditorScrollArea">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
              <horstretch>1</horstretch>
              <verstretch>1</verstretch>
             </sizepolicy>
            </property>
            <property name="widgetResizable">
             <bool>false</bool>
            </property>
            <widget class="SpritePixelEditor" name="theSpritePixelEditor"/>
           </widget>
          </item>
          <!-- Right: tool panel (built programmatically) -->
          <item>
           <widget class="QWidget" name="theEditorToolPanel">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Fixed" vsizetype="Preferred">
              <horstretch>0</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="minimumWidth">
             <number>100</number>
            </property>
            <property name="maximumWidth">
             <number>120</number>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <!-- Bottom bar: zoom, grid, save buttons -->
        <item>
         <layout class="QHBoxLayout" name="editorBottomLayout">
          <item>
           <widget class="QLabel" name="editorZoomLabel">
            <property name="text">
             <string>Zoom:</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QSpinBox" name="theEditorZoomSpin">
            <property name="minimum">
             <number>1</number>
            </property>
            <property name="maximum">
             <number>32</number>
            </property>
            <property name="value">
             <number>8</number>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="theEditorGridCheck">
            <property name="text">
             <string>Grid</string>
            </property>
            <property name="checked">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <spacer name="editorBottomSpacer">
            <property name="orientation">
             <enum>Qt::Horizontal</enum>
            </property>
           </spacer>
          </item>
          <item>
           <widget class="QPushButton" name="theEditorSaveButton">
            <property name="text">
             <string>Save Tiles to ROM</string>
            </property>
            <property name="enabled">
             <bool>false</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="theEditorSavePaletteButton">
            <property name="text">
             <string>Save Palette to ROM</string>
            </property>
            <property name="enabled">
             <bool>false</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="theEditorCloseButton">
            <property name="text">
             <string>Close</string>
            </property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
  <!-- Menu bar -->
  <widget class="QMenuBar" name="menuBar">
   <property name="geometry">
    <rect>
     <x>0</x>
     <y>0</y>
     <width>1024</width>
     <height>22</height>
    </rect>
   </property>
   <widget class="QMenu" name="menuFile">
    <property name="title">
     <string>File</string>
    </property>
    <addaction name="actionOpenRom"/>
    <addaction name="actionOpenGameDef"/>
    <addaction name="separator"/>
    <addaction name="actionSaveRom"/>
    <addaction name="actionSaveRomAs"/>
    <addaction name="actionSaveGameDef"/>
    <addaction name="separator"/>
    <addaction name="actionQuit"/>
   </widget>
   <widget class="QMenu" name="menuEdit">
    <property name="title">
     <string>Edit</string>
    </property>
   </widget>
   <widget class="QMenu" name="menuHelp">
    <property name="title">
     <string>Help</string>
    </property>
    <addaction name="actionAbout"/>
   </widget>
   <addaction name="menuFile"/>
   <addaction name="menuEdit"/>
   <addaction name="menuHelp"/>
  </widget>
  <!-- Status bar -->
  <widget class="QStatusBar" name="statusBar"/>
  <!-- Actions -->
  <action name="actionOpenRom">
   <property name="text">
    <string>Open ROM...</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+O</string>
   </property>
  </action>
  <action name="actionOpenGameDef">
   <property name="text">
    <string>Open Game Definition...</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+D</string>
   </property>
  </action>
  <action name="actionSaveRom">
   <property name="text">
    <string>Save ROM</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+S</string>
   </property>
  </action>
  <action name="actionSaveRomAs">
   <property name="text">
    <string>Save ROM As...</string>
   </property>
  </action>
  <action name="actionQuit">
   <property name="text">
    <string>Quit</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+Q</string>
   </property>
  </action>
  <action name="actionSaveGameDef">
   <property name="text">
    <string>Save Game Definition</string>
   </property>
  </action>
  <action name="actionAbout">
   <property name="text">
    <string>About</string>
   </property>
  </action>
 </widget>
 <layoutdefault spacing="6" margin="11"/>
