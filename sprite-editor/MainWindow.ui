            </layout>
           </item>
           <!-- Placeholder for SpriteSheetWidget (added programmatically inside a QScrollArea) -->
           <item>
            <widget class="QScrollArea" name="theSpriteScrollArea">
             <property name="sizePolicy">
              <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
