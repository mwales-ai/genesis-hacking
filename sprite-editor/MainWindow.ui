<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1024</width>
    <height>768</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Genesis Sprite Editor</string>
  </property>
  <widget class="QWidget" name="centralWidget">
   <layout class="QVBoxLayout" name="centralLayout">
    <property name="spacing">
     <number>4</number>
    </property>
    <property name="margin">
     <number>6</number>
    </property>
    <item>
     <widget class="QLabel" name="theStatusLabel">
      <property name="text">
       <string>No ROM loaded</string>
      </property>
      <property name="frameShape">
       <enum>QFrame::StyledPanel</enum>
      </property>
     </widget>
    </item>
    <item>
     <widget class="QTabWidget" name="theTabWidget">
      <property name="currentIndex">
       <number>0</number>
      </property>
      <!-- ===================== TAB 0: Sprite Viewer ===================== -->
      <widget class="QWidget" name="tabSpriteViewer">
       <attribute name="title">
        <string>Sprite Viewer</string>
       </attribute>
       <layout class="QHBoxLayout" name="spriteViewerLayout">
        <property name="spacing">
         <number>6</number>
        </property>
        <!-- LEFT PANEL: group selector + sprite sheet grid + palette -->
        <item>
         <widget class="QWidget" name="leftPanel">
          <property name="minimumWidth">
           <number>320</number>
          </property>
          <layout class="QVBoxLayout" name="leftLayout">
           <item>
            <layout class="QHBoxLayout" name="groupLayout">
             <item>
              <widget class="QLabel" name="groupLabel">
               <property name="text">
                <string>Sprite Group:</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QComboBox" name="theGroupCombo">
               <property name="enabled">
                <bool>false</bool>
               </property>
               <property name="sizePolicy">
                <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                 <horstretch>1</horstretch>
                 <verstretch>0</verstretch>
                </sizepolicy>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="theRenameButton">
               <property name="text">
                <string>Rename</string>
               </property>
               <property name="enabled">
                <bool>false</bool>
               </property>
               <property name="toolTip">
                <string>Rename the selected sprite collection</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="theEditFromViewerButton">
               <property name="text">
                <string>Edit</string>
               </property>
               <property name="enabled">
                <bool>false</bool>
               </property>
               <property name="toolTip">
                <string>Open the selected sprite/collection in the Sprite Editor</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
           <!-- SpriteSheetWidget inside a scroll area -->
           <item>
            <widget class="QScrollArea" name="theSpriteScrollArea">
             <property name="sizePolicy">
              <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
               <horstretch>0</horstretch>
               <verstretch>1</verstretch>
              </sizepolicy>
             </property>
             <property name="widgetResizable">
              <bool>true</bool>
             </property>
             <widget class="SpriteSheetWidget" name="theSpriteSheet"/>
            </widget>
           </item>
           <!-- PaletteWidget (promoted) -->
           <item>
            <widget class="PaletteWidget" name="thePaletteDisplay"/>
           </item>
          </layout>
         </widget>
        </item>
        <!-- RIGHT PANEL: detail view, zoom controls, replace button -->
        <item>
         <widget class="QWidget" name="rightPanel">
          <property name="minimumWidth">
           <number>200</number>
          </property>
          <property name="maximumWidth">
           <number>400</number>
          </property>
          <layout class="QVBoxLayout" name="rightLayout">
           <item>
            <widget class="QLabel" name="theSpriteName">
             <property name="text">
              <string>(no sprite selected)</string>
             </property>
             <property name="alignment">
              <set>Qt::AlignCenter</set>
             </property>
            </widget>
           </item>
           <!-- TileCanvasWidget (promoted) inside a scroll area for large sprites -->
           <item>
            <widget class="QScrollArea" name="theDetailScrollArea">
             <property name="sizePolicy">
              <sizepolicy hsizetype="Preferred" vsizetype="Expanding">
               <horstretch>0</horstretch>
               <verstretch>1</verstretch>
              </sizepolicy>
             </property>
             <property name="widgetResizable">
              <bool>false</bool>
             </property>
             <widget class="TileCanvasWidget" name="theSpriteDetail"/>
            </widget>
           </item>
           <!-- Zoom + grid controls -->
           <item>
            <layout class="QHBoxLayout" name="zoomLayout">
             <item>
              <widget class="QLabel" name="zoomLabel">
               <property name="text">
                <string>Zoom:</string>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QSpinBox" name="theZoomSpin">
               <property name="minimum">
                <number>1</number>
               </property>
               <property name="maximum">
                <number>8</number>
               </property>
               <property name="value">
                <number>4</number>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QCheckBox" name="theGridCheck">
               <property name="text">
                <string>Show Grid</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
           <!-- Offset info label -->
           <item>
            <widget class="QLabel" name="theOffsetLabel">
             <property name="text">
              <string></string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <!-- Action buttons -->
           <item>
            <layout class="QHBoxLayout" name="actionLayout">
             <item>
              <widget class="QPushButton" name="theReplaceButton">
               <property name="text">
                <string>Replace Sprite</string>
               </property>
               <property name="enabled">
                <bool>false</bool>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="theExportButton">
               <property name="text">
                <string>Export PNG</string>
               </property>
               <property name="enabled">
                <bool>false</bool>
               </property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="theExportAllButton">
               <property name="text">
                <string>Export All</string>
               </property>
               <property name="enabled">
                <bool>false</bool>
               </property>
               <property name="toolTip">
                <string>Export all sprites in the current group as individual PNG files</string>
               </property>
              </widget>
             </item>
            </layout>
           </item>
           <item>
            <spacer>
             <property name="orientation">
              <enum>Qt::Vertical</enum>
             </property>
             <property name="sizeHint" stdset="0">
              <size>
               <width>20</width>
               <height>20</height>
              </size>
             </property>
            </spacer>
           </item>
          </layout>
         </widget>
        </item>
       </layout>
      </widget>
